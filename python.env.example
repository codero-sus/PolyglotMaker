# Copy this file to python.env and set the first non-comment line to a Python executable.
# Relative paths are resolved from the project root; leave the path unquoted.
#
# Linux/macOS example:
# .venv/bin/python
#
# Windows example:
# C:\PortablePython\python.exe
#
# An explicit assignment is also accepted:
# PYTHON=/path/to/python
